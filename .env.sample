PORT=2000
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
my_cloud_name="your_cloudinary_cloud_name"
my_key="your_cloudinary_api_key"
my_secret="your_cloudinary_api_secret"
MY_EMAIL="your_email@example.com"
MY_PASS="your_email_app_password"
BASE_URL="http://localhost:2000"
FRONTEND_URL="http://localhost:5173"
ACCESS_TOKEN_SECRET="replace_with_a_long_random_string"
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET="replace_with_a_different_long_random_string"
REFRESH_TOKEN_EXPIRY=7d
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
CORS_ORIGIN="http://localhost:5173"
TZ="Asia/Kolkata"